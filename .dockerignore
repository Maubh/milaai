# Allow only the inputs explicitly copied by the site Dockerfile.
**
!package.json
!package-lock.json
!next-env.d.ts
!next.config.mjs
!tsconfig.json
!middleware.ts
!tokens.css
!app/
!app/**
!components/
!components/**
!lib/
!lib/**
!public/
!public/**
!ops/
!ops/container/
!ops/container/Dockerfile

# These exclusions win even inside an otherwise allowed source directory.
**/.env*
**/*.env
**/*secret*
**/*credential*
**/secrets
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/node_modules
**/node_modules/**
**/.next
**/.next/**
**/.git
**/.git/**
**/*.tsbuildinfo
**/*.log
