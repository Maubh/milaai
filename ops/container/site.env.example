# Copy OUTSIDE the checkout to /docker/milaai/secrets/deploy.env (mode 0600).
# Used by docker compose --env-file, NOT copied into the image or cloudflared.
MILAAI_SITE_IMAGE=milaai-site:REPLACE_WITH_REVIEWED_RELEASE
# Prefer an approved digest for repeatable builds.
MILAAI_NODE_IMAGE=node:24-trixie-slim
MILAAI_CLOUDFLARED_IMAGE=
MILAAI_TUNNEL_CONFIG_FILE=/docker/milaai/config.yml
MILAAI_TUNNEL_CREDENTIALS_FILE=/docker/milaai/secrets/tunnel.json

# PUBLIC build-time values: recover the SAME values used by the current site.
# Changing these requires a rebuild, not just a container restart.
NEXT_PUBLIC_MILA_WA_E164=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Runtime-only. Empty/missing values stop Compose before it can start.
MILA_AUTH_SECRET=
MILA_INTERNAL_HMAC_SECRET=
TURNSTILE_SECRET_KEY=
# Leave empty for the existing apex/www => .milaai.com.br rule.
MILA_COOKIE_DOMAIN=

# MILA_AUTH_BASE and MILA_INTERNAL_API_URL are fixed by Compose to
# http://mila-eve:4274; public browser/OAuth addresses remain HTTPS.
